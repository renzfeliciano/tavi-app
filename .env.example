# Copy to .env.local and fill in. Never commit real values.
# Every variable here is validated at startup by src/shared/env/parse-env.ts.

# Public base URL of the app (used for links in emails and public portals).
# Must be https in production.
APP_URL=http://localhost:3200

# --- Added in Phase 0.2 (database) ---
# Neon `dev` branch, pooled connection (host contains "-pooler").
# DATABASE_URL=
# Neon `dev` branch, direct connection (pooling off). Used for migrations.
# DATABASE_URL_DIRECT=
