# Copy to .env.local and fill in. Never commit real values.
# Every variable here is validated at startup by src/shared/env/parse-env.ts.

# Public base URL of the app (used for links in emails and public portals).
# Must be https in production.
APP_URL=http://localhost:3200

# Neon `dev` branch, pooled connection (host contains "-pooler"). Used by the app.
DATABASE_URL=
# Same branch with pooling off (the same URL without "-pooler"). Used by
# `npm run db:migrate` and `npm run db:studio`.
DATABASE_URL_DIRECT=
# Neon `test` branch, pooling off. `npm run test:int` WIPES this database on
# every run, and refuses to run if it matches DATABASE_URL.
TEST_DATABASE_URL=

# Signs session cookies and tokens. Generate with: openssl rand -base64 32
# Required in production; use a different value per environment.
BETTER_AUTH_SECRET=

# --- Email ---
# Without a transport, development prints emails to the terminal and
# production refuses to send (flows still work; failures are logged).
#
# Free tier (D11): Gmail SMTP. Turn on 2-Step Verification, then create an
# App Password (Google Account > Security > App passwords). EMAIL_FROM must
# be the same Gmail address.
SMTP_USER=
SMTP_PASSWORD=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
EMAIL_FROM="Tavi <your.address@gmail.com>"
#
# Later, with a verified domain: Resend takes precedence when set.
RESEND_API_KEY=

# Shared secret Vercel Cron sends to /api/cron/* (at least 32 characters).
CRON_SECRET=
